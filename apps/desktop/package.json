{
  "name": "@agentkib/desktop",
  "private": true,
  "version": "0.22.0",
  "description": "Desktop app for discovering, diagnosing, and synchronizing coding agent configuration.",
  "homepage": "https://github.com/starroyhq/agentkib",
  "author": "AgentKib contributors",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "verify:windows:mcp-cleanup": "pnpm protocol:generate && pnpm backend:build && node scripts/run-windows-mcp-cleanup.mjs",
    "dev": "pnpm dev:typescript",
    "dev:typescript": "pnpm protocol:generate && pnpm cursor:stage && pnpm quota:prepare && pnpm quota:stage && pnpm backend:build && cross-env AGENTKIB_DEV=1 electron-vite dev --watch",
    "build": "pnpm build:electron",
    "build:electron": "pnpm protocol:generate && pnpm cursor:stage && pnpm relay:stage && pnpm --filter @agentkib/web build && pnpm build:web && pnpm electron:build",
    "build:web": "tsc -b && cross-env AGENTKIB_BUILD_TARGET=renderer electron-vite build --ignoreConfigWarning",
    "electron:build": "pnpm backend:build && cross-env AGENTKIB_BUILD_TARGET=electron electron-vite build --ignoreConfigWarning",
    "quota:stage": "node scripts/stage-electron-quota.mjs",
    "protocol:generate": "node scripts/generate-runtime-protocol.mjs",
    "dist:electron": "pnpm protocol:generate && pnpm cursor:stage && pnpm quota:prepare && pnpm quota:stage && pnpm relay:stage && pnpm --filter @agentkib/web build && pnpm build:web && pnpm electron:build && electron-builder",
    "quota:prepare": "node scripts/prepare-quota-sidecar.mjs",
    "icons:tray": "swift scripts/generate-tray-icon.swift",
    "benchmark:runtime": "node scripts/benchmark-runtime.mjs",
    "benchmark:memory": "node scripts/benchmark-backend-memory.mjs",
    "test": "pnpm backend:build && vitest run",
    "benchmark:conversation": "node scripts/benchmark-conversation.mjs",
    "typecheck": "tsc -b --pretty false",
    "relay:stage": "node scripts/stage-frpc.mjs",
    "backend:build": "pnpm claude:stage && vite build --config vite.backend.config.ts && node scripts/stage-backend-native.mjs",
    "cursor:stage": "node scripts/stage-cursor-bridge.mjs",
    "claude:stage": "node scripts/stage-claude-bridge.mjs"
  },
  "dependencies": {
    "@agentkib/agent-identity": "workspace:*",
    "@agentkib/backend": "workspace:*",
    "@agentkib/conversation-state": "workspace:*",
    "@agentkib/runtime-protocol": "workspace:*",
    "@agentkib/session-catalog": "workspace:*",
    "@agentkib/session-ui": "workspace:*",
    "@agentkib/web-client": "workspace:*",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/markdown": "^1.0.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "cross-spawn": "^7.0.6",
    "d3-hierarchy": "^3.1.2",
    "electron-updater": "^6.8.9",
    "i18next": "^26.5.3",
    "koffi": "^3.3.3",
    "lucide-react": "^1.59.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "react-resizable-panels": "^4.14.7",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.2.14",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/router-plugin": "^1.168.47",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "dmg-builder": "26.17.0",
    "electron": "^44.9.1",
    "electron-builder": "^26.17.0",
    "electron-builder-squirrel-windows": "26.17.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^30.1.3",
    "oxc-transform-react": "^0.152.0",
    "shadcn": "^4.22.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
