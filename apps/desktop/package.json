{
  "name": "@agentkib/desktop",
  "private": true,
  "version": "0.8.0",
  "description": "Desktop app for discovering, diagnosing, and synchronizing coding agent configuration.",
  "author": "AgentKib contributors",
  "homepage": "https://github.com/starroyhq/agentkib",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "pnpm dev:electron",
    "dev:electron": "pnpm protocol:generate && pnpm quota:prepare && pnpm quota:stage && pnpm runtime:build:dev && pnpm electron:build && concurrently -k -n renderer,electron \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:1420 && cross-env AGENTKIB_DEV=1 VITE_DEV_SERVER_URL=http://127.0.0.1:1420 electron dist-electron/main.cjs\"",
    "build": "pnpm build:electron",
    "build:electron": "pnpm protocol:generate && pnpm runtime:build && pnpm runtime:stage && pnpm build:web && pnpm electron:build",
    "build:web": "tsc -b && vite build",
    "electron:build": "vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts",
    "runtime:build:dev": "cargo build -p agentkib-runtime --features dev-app",
    "runtime:build": "cargo build --release -p agentkib-runtime",
    "runtime:stage": "node scripts/stage-electron-runtime.mjs",
    "quota:stage": "node scripts/stage-electron-quota.mjs",
    "protocol:generate": "node scripts/generate-runtime-protocol.mjs",
    "dist:electron": "pnpm protocol:generate && pnpm runtime:build && pnpm quota:prepare && pnpm runtime:stage && pnpm build:web && pnpm electron:build && electron-builder",
    "quota:prepare": "node scripts/prepare-quota-sidecar.mjs",
    "icons:tray": "swift scripts/generate-tray-icon.swift",
    "benchmark:runtime": "node scripts/benchmark-runtime.mjs",
    "test": "pnpm runtime:build:dev && vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-query": "^5",
    "@tanstack/react-router": "^1.170.31",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.4",
    "d3-hierarchy": "^3.1.2",
    "electron-updater": "^6.8.9",
    "i18next": "^25.5.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.7.3",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@rolldown/binding-linux-x64-gnu": "1.2.5",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/router-plugin": "^1.168.34",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "dmg-builder": "26.15.7",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.7",
    "electron-builder-squirrel-windows": "26.15.7",
    "jsdom": "^25.0.1",
    "shadcn": "^4.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  }
}
