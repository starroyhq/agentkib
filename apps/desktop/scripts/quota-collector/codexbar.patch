--- /dev/null
+++ b/Tests/CodexBarTests/AgentKibDashboardTests.swift
@@ -0,0 +1,46 @@
+import CodexBarCore
+import Foundation
+import Testing
+@testable import CodexBarCLI
+
+struct AgentKibDashboardTests {
+    @Test(arguments: [false, true])
+    func localCostsAreOptionalWithoutChangingQuotaSelection(includeCosts: Bool) async throws {
+        let calls = AgentKibCollectorCalls()
+        var producer = DashboardSnapshotProducer(
+            collectUsage: { providers in
+                await calls.usage(providers)
+                var output = UsageCommandOutput()
+                output.payload = providers.map { provider in
+                    ProviderPayload(provider: provider, account: nil, version: nil,
+                        source: "fixture", status: nil, usage: nil, credits: nil,
+                        antigravityPlanInfo: nil, openaiDashboard: nil, error: nil)
+                }
+                return output
+            },
+            collectCost: { _, _ in await calls.cost(); return [] },
+            now: { Date(timeIntervalSince1970: 1_800_000_000) },
+            collectAccounts: { _, provider in await calls.account(provider); return nil })
+        #expect(producer.includeLocalCosts)
+        producer.includeLocalCosts = includeCosts
+        let result = try await producer.collect(
+            config: CodexBarConfig(providers: [ProviderConfig(id: .codex, enabled: true),
+                                               ProviderConfig(id: .claude, enabled: true)]),
+            refreshInterval: 0, codexBarVersion: "0.83.0", providers: [.codex])
+        #expect(await calls.costs == (includeCosts ? 1 : 0))
+        #expect(await calls.usageSelection == [.codex])
+        #expect(await calls.accountSelection == [.codex])
+        let json = try JSONSerialization.jsonObject(with: JSONEncoder().encode(result.payload)) as! [String: Any]
+        let rows = json["providers"] as! [[String: Any]]
+        #expect(rows.count == 1)
+        #expect(rows[0]["id"] as? String == "codex")
+    }
+}
+private actor AgentKibCollectorCalls {
+    var costs = 0
+    var usageSelection: [UsageProvider] = []
+    var accountSelection: [UsageProvider] = []
+    func cost() { costs += 1 }
+    func usage(_ providers: [UsageProvider]) { usageSelection = providers }
+    func account(_ provider: UsageProvider) { accountSelection.append(provider) }
+}
