+// Coverage describes the scan, independently of which dates had activity.
+// Missing activity dates stay omitted from the separately filtered projection.
+fn agentkib_codex_window_covered(cache: &CostUsageCache, daily: &HashMap<String, u64>) -> bool {
+    if cache.codex_scan_incomplete || cache.previous_report.is_some() {
+        return false;
+    }
+    let (Some(since), Some(until)) = (&cache.scan_since_key, &cache.scan_until_key) else {
+        return false;
+    };
+    !daily.is_empty() && daily.keys().all(|day| day >= since && day <= until)
+}
