+        let mut cache = CostUsageCache {
+            scan_since_key: Some("2026-11-04".to_string()),
+            scan_until_key: Some("2026-11-05".to_string()),
+            ..Default::default()
+        };
+        assert!(agentkib_codex_window_covered(&cache, &daily));
+        cache.scan_since_key = Some("2026-11-05".to_string());
+        assert!(!agentkib_codex_window_covered(&cache, &daily), "an unscanned date is not zero");
+        cache.scan_since_key = Some("2026-11-04".to_string());
+        cache.codex_scan_incomplete = true;
+        assert!(!agentkib_codex_window_covered(&cache, &daily), "pending or failed scans remain unknown");
+        cache.codex_scan_incomplete = false;
+        cache.previous_report = Some(JsonlScanner::cached_cost_report_from_days(&cache));
+        assert!(!agentkib_codex_window_covered(&cache, &daily), "a preserved report is not current scan coverage");
+        cache.previous_report = None;
+        cache.scan_until_key = None;
+        assert!(!agentkib_codex_window_covered(&cache, &daily), "missing coverage bounds remain unknown");
+    }
