{
  "name": "@agentkib/web",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm typecheck && vite build",
    "build:hosted": "pnpm typecheck && vite build --mode hosted",
    "typecheck": "pnpm routes:generate && tsc --noEmit",
    "test": "vitest run",
    "routes:generate": "tsr generate"
  },
  "dependencies": {
    "@agentkib/agent-identity": "workspace:*",
    "@agentkib/session-catalog": "workspace:*",
    "@agentkib/session-ui": "workspace:*",
    "@agentkib/web-client": "workspace:*",
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-router": "^1.170.31",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/router-cli": "^1.167.35",
    "@tanstack/router-plugin": "^1.168.34",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
